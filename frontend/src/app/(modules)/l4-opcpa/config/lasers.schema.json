{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "lasers": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "Laser id, e.g. NL2. Panel title; also the <LASER> in command PVs (CMD_<id>_<NAME>)."
          },
          "pvs": {
            "type": "object",
            "properties": {
              "connection": {
                "type": "string",
                "minLength": 1,
                "description": "Connection bool (Overview CONN)."
              },
              "fullPower": {
                "type": "string",
                "minLength": 1,
                "description": "At-full-power bool (Overview FULLP)."
              },
              "shutter": {
                "type": "string",
                "minLength": 1,
                "description": "Shutter position bool (read + direct write)."
              },
              "phdMean": {
                "type": "string",
                "minLength": 1,
                "description": "PHD mean intensity readout."
              },
              "regenState": {
                "type": "string",
                "minLength": 1,
                "description": "Regen on/off bool."
              },
              "regenTemp": {
                "type": "string",
                "minLength": 1,
                "description": "Regen temperature readout."
              },
              "phd2Mean": {
                "type": "string",
                "minLength": 1,
                "description": "Second PHD mean readout."
              },
              "attenuator": {
                "type": "string",
                "minLength": 1,
                "description": "Attenuator value (read + direct write)."
              },
              "loadedWaveform": {
                "type": "string",
                "minLength": 1,
                "description": "Current waveform preset."
              },
              "latestWaveform": {
                "description": "Previous waveform name shown in Waveform Latest after a new preset is applied.",
                "type": "string",
                "minLength": 1
              },
              "modboxMbc1": {
                "description": "Modbox MBC1 readout (Modbox State row).",
                "type": "string",
                "minLength": 1
              },
              "modboxMbc2": {
                "description": "Modbox MBC2 readout (Modbox State row).",
                "type": "string",
                "minLength": 1
              },
              "sequencerRunning": {
                "description": "Sequencer running bool (Sequencer row: 1=RUNNING, 0=IDLE).",
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "connection",
              "fullPower",
              "shutter",
              "phdMean",
              "regenState",
              "regenTemp",
              "phd2Mean",
              "attenuator",
              "loadedWaveform"
            ],
            "additionalProperties": false,
            "description": "Single-signal read/write PVs."
          },
          "triggerDelay": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Trigger-delay readout PVs; all should read equal (mismatch flagged)."
          },
          "mss": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "MSS sub-indicator PVs (counted in the General overview)."
          },
          "moduleErrors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Display label shown in the UI."
                },
                "pv": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Full EPICS PV name (from controls)."
                }
              },
              "required": [
                "label",
                "pv"
              ],
              "additionalProperties": false
            },
            "description": "Module-error indicators (label + PV) counted in the Overview."
          },
          "chillers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Chiller display label, e.g. PS1225:11."
                },
                "flow": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Flow readout PV."
                },
                "temp": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Temperature readout PV."
                },
                "level": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Water-level readout PV."
                }
              },
              "required": [
                "label",
                "flow",
                "temp",
                "level"
              ],
              "additionalProperties": false
            },
            "description": "Chillers. Empty array hides the Chillers section."
          },
          "flashlamps": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Display label shown in the UI."
                },
                "pv": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Full EPICS PV name (from controls)."
                }
              },
              "required": [
                "label",
                "pv"
              ],
              "additionalProperties": false
            },
            "description": "Flashlamp channels (label + PV). Empty array hides the Flashlamps section."
          },
          "modbox": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Modbox state PVs. Empty array hides the Modbox section."
          },
          "delayPresets": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "description": "Trigger-delay preset values (ns) offered by the Set Trigger Delay control."
          },
          "commands": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "START_LASER",
                "STOP_LASER",
                "ALIGNMENT_MODE",
                "SYSTEM_STANDBY",
                "FLASHLAMPS_RUN",
                "FLASHLAMPS_STANDBY",
                "MODBOX_ON",
                "MODBOX_OFF",
                "SET_DELAY",
                "LOAD_WAVEFORM"
              ]
            },
            "description": "Commands this laser exposes (closed LASER_COMMANDS vocabulary; map to backend sequences). Unlisted → button hidden."
          }
        },
        "required": [
          "id",
          "pvs",
          "triggerDelay",
          "mss",
          "moduleErrors",
          "chillers",
          "flashlamps",
          "modbox",
          "delayPresets",
          "commands"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "lasers"
  ],
  "additionalProperties": false
}
