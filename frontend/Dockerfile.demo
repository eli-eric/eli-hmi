FROM harbor.eli-beams.eu/eli_images/eli-node:22-alpine

# Create group and user with GID/UID 1200
RUN addgroup -g 1200 -S appgroup && \
    adduser -D -u 1200 -G appgroup appuser

WORKDIR /app

COPY frontend/package.json frontend/package-lock.json* frontend/.npmrc* ./
RUN npm ci

COPY frontend/ ./
COPY eli-hmi-config/ /app/zone-config/

ENV HOSTNAME=0.0.0.0 \
    CONFIG_DIR=/app/zone-config

EXPOSE 8082

# Ensure the non-root user can write build artifacts such as .next during dev
RUN chown -R 1200:1200 /app

# Run container as UID 1200, GID 1200
USER 1200:1200

CMD ["npm", "run", "dev", "--", "--hostname", "0.0.0.0"]
