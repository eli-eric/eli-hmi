# env for Next Auth
NEXTAUTH_SECRET=your_secret_key_here
NEXTAUTH_URL=http://localhost:8082/api/auth

# api url example
# host:port for both ws://<host>/ws/pvs and http://<host>/pv
API_URL=localhost:8080
# Scheme for API_URL; set to https for TLS deployments
API_SCHEME=http

# LDAP Authentication Settings
LDAP_SERVER_URL=ldap://10.78.0.11
LDAP_BASE_DN=dc=lcs,dc=local
LDAP_USE_TLS=false

# Zone Configuration
# Which deployment zone this instance is. A code is valid exactly when it is a
# key under `zones:` in config/global.yaml — that file ships inside the image,
# so switching zones is a restart with a different value here, never a rebuild.
# Unset or unknown → every page serves /no-access (and the boot log says so).
# Read live at runtime — no NEXT_PUBLIC_ prefix, so Next does not inline it.
ZONE_CODE=test

# Set to true in production, false in development
NODE_ENV=development
