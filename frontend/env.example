# env for Next Auth
NEXTAUTH_SECRET=your_secret_key_here
NEXTAUTH_URL=http://localhost:8082/api/auth

# api url example
NEXT_PUBLIC_API_URL=localhost:8080

# LDAP Authentication Settings
LDAP_SERVER_URL=ldap://10.78.0.11
LDAP_BASE_DN=dc=lcs,dc=local
LDAP_USE_TLS=false

# Zone Configuration
# Controls which pages/routes are accessible based on deployment zone
# Options: 'test', 'production', or custom zone codes
# Defaults to empty zone (no pages accessible) if not set
# IMPORTANT: Must use NEXT_PUBLIC_ prefix to be available on both server and client
NEXT_PUBLIC_ZONE_CODE=test

# Set to true in production, false in development
NODE_ENV=development
