# env for Next Auth
NEXTAUTH_SECRET=your_secret_key_here
NEXTAUTH_URL=http://localhost:8082/api/auth

# api url example
# host:port for both ws://<host>/ws/pvs and http://<host>/pv
API_URL=localhost:8080
# Scheme for API_URL; set to https for TLS deployments
API_SCHEME=http

# LDAP Authentication Settings
LDAP_SERVER_URL=ldap://10.78.0.11
LDAP_BASE_DN=dc=lcs,dc=local
LDAP_USE_TLS=false

# Zone Configuration (CSI-861)
# Which deployment zone this instance is. FREE-FORM — there is no hardcoded
# zone list in the app: a code is valid exactly when zones/<ZONE_CODE>.yaml
# exists in the config directory (see CONFIG_DIR below). The zone file drives
# navigation, allowed routes, and per-module PV config.
# Defaults to empty zone (no pages accessible, /no-access) if not set.
# Read live at runtime — no NEXT_PUBLIC_ prefix, so a docker-compose restart
# with a different value is enough to switch zones, no rebuild required.
ZONE_CODE=test

# Zone-config directory (CSI-861)
# Where the zone + module config lives. In deployments this is the mount path
# of a clone of the controls-team config repo (layout documented in
# ../eli-hmi-config/README.md), e.g. CONFIG_DIR=/app/zone-config with a
# read-only volume mount. Unset in development → falls back to the in-repo
# template ../eli-hmi-config.
# Config is read + validated at container start and cached: config change =
# restart, never a rebuild. A broken/missing config stops the container with
# a readable error (fail-fast, see src/instrumentation.ts).
#CONFIG_DIR=/app/zone-config

# Set to true in production, false in development
NODE_ENV=development
