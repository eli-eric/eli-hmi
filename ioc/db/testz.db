record(calc, "L4-OPCPA-NL2:ModBox:MBC1:BiasValue") {
    field(DESC, "NL2 modboxMbc")
    field(SCAN, "1 second")
    field(PINI, "YES")
    field(VAL, "0.0")
    field(INPA, "L4-OPCPA-NL2:ModBox:MBC1:BiasValue.VAL NPP NMS")
    field(B, "1000.0")
    field(C, "-10000.0")
    field(D, "10000.0")
    field(CALC, "FLOOR(MIN(D,MAX(C,A+(RNDM-0.5)*B))+0.5)")
