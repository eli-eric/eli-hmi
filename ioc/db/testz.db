# One write, 16 records.
record(dfanout, "SIM:CMD_NL2_START_LASER:fan0_1") {
    field(DESC, "CMD_NL2_START_LASER -> 16 records")
    field(VAL, "1")
    field(OUTA, "L4-OPCPA-NL2:FullPower PP")
    field(OUTB, "L4-OPCPA-NL2:IO:15:RC1_pin31 PP")
    field(OUTC, "L4-OPCPA-NL2:SY3PL50M:32:State PP")
    field(OUTD, "L4-OPCPA-NL2:PS5059:22:Ch1_State PP")
    field(OUTE, "L4-OPCPA-NL2:PS5059:22:Ch2_State PP")
    field(OUTF, "L4-OPCPA-NL2:PS5059:23:Ch1_State PP")
