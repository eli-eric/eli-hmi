record(dfanout, "$(CP):PS5059:22:SetTriggeringDelay") {
    field(OUTA, "$(CP):PS5059:22:Ch1TriggeringDelay:SET PP")
    field(OUTB, "$(CP):PS5059:22:Ch2TriggeringDelay:SET PP")
}

record(mbbo, "SetFlashlamps") {
    field(ZRST, "STANDBY")
    field(ONST, "STOP")
    field(TWST, "RUN")
    field(FLNK, "FlashlampsCMD")
}

record(dfanout, "FlashlampsCMD") {
    field(OUTA, "SI_NL2_FL_22_CH1 PP")
    field(OUTB, "SI_NL2_FL_22_CH2 PP")
    field(OUTC, "SI_NL2_FL_23_CH1 PP")
    field(OUTD, "SI_NL2_FL_23_CH2 PP")
    field(OUTE, "SI_NL2_FL_24_CH1 PP")
    field(OUTF, "SI_NL2_FL_24_CH2 PP")
    field(OUTG, "SI_NL2_FL_25_CH1 PP")
    field(OUTH, "SI_NL2_FL_25_CH2 PP")
    field(FLNK, "FlashlampsCMD2")
}
record(dfanout, "FlashlampsCMD2") {
    field(OUTA, "SI_NL2_FL_26_CH1 PP")
    field(OUTB, "SI_NL2_FL_26_CH2 PP")
    field(OUTC, "SI_NL2_FL_27_CH1 PP")
    field(OUTD, "SI_NL2_FL_27_CH2 PP")
    field(OUTE, "SI_NL2_FL_28_CH1 PP")
    field(OUTF, "SI_NL2_FL_28_CH2 PP")
}

record(bo, "BI_NL2_SEQUENCER_RUNNING") {
    field(SCAN, "1 second")
    field(DOL,  "0")
    field(OMSL, "closed_loop")
}

record(bo, "FLASHLAMPS_RUN") {
    field(FLNK, "_FlashlampsRun")
}

record(longout, "_FlashlampsRun") {
    field(DOL,  "2")
    field(OMSL, "closed_loop")
    field(OUT,  "SetFlashlamps PP")
}

record(bo, "FLASHLAMPS_STANDBY") {
    field(FLNK, "_FlashlampsStandby")
}

record(longout, "_FlashlampsStandby") {
    field(DOL,  "0")
    field(OMSL, "closed_loop")
    field(OUT,  "SetFlashlamps PP")
}