record(stringin, "SI_NL2_LOADED_WAVEFORM") {
    field(DESC, "NL2 loaded waveform")
    field(PINI, "YES")
    field(VAL, "std-100ps")
}
record(stringin, "SI_NL2_LATEST_WAVEFORM") {
    field(DESC, "NL2 previous waveform")
    field(PINI, "YES")
    field(VAL, "narrow-50ps")
}
record(calc, "L4-OPCPA-NL2::ModBox:MBC1:BiasValue") {
    field(DESC, "NL2 MBC1 bias")
    field(SCAN, "1 second")
    field(PINI, "YES")
    field(VAL, "2.1")
    field(INPA, "L4-OPCPA-NL2::ModBox:MBC1:BiasValue.VAL NPP NMS")
    field(B, "0.03")
    field(C, "1.8")
    field(D, "2.4")
    field(CALC, "MIN(D,MAX(C,A+(RNDM-0.5)*B))")
    field(EGU, "V")
    field(PREC, "2")
    field(LOPR, "1.8")
    field(HOPR, "2.4")
}
record(calc, "L4-OPCPA-NL2::ModBox:MBC2:BiasValue") {
    field(DESC, "NL2 MBC2 bias")
    field(SCAN, "1 second")
    field(PINI, "YES")
    field(VAL, "2.1")
    field(INPA, "L4-OPCPA-NL2::ModBox:MBC2:BiasValue.VAL NPP NMS")
    field(B, "0.03")
    field(C, "1.8")
    field(D, "2.4")
    field(CALC, "MIN(D,MAX(C,A+(RNDM-0.5)*B))")
    field(EGU, "V")
    field(PREC, "2")
    field(LOPR, "1.8")
    field(HOPR, "2.4")
}

