# Writing 'Sleep' here runs the MODBOX_OFF chain. Base has no record that can compare strings, so ANY write to it runs the chain — the panel only ever writes this one value.
record(stringout, "L4-OPCPA-NL2:ModBox:Awake") {
    field(DESC, "MODBOX_OFF trigger")
    field(FLNK, "SIM:NL2:seqModboxOff")
}
record(seq, "SIM:NL2:seqModboxOff") {
    field(DESC, "sequence seqModboxOff")
    field(SELM, "All")
    field(DLY0, "0")
    field(DO0, "1")
    field(LNK0, "L4-OPCPA-NL2:SetAlignmentMode:BUSY PP")
    field(DLY1, "0")
    field(DO1, "0")
    field(LNK1, "SIM:NL2:modboxAll PP")
    field(DLY2, "0")
    field(DO2, "0")
    field(LNK2, "L4-OPCPA-NL2:SetAlignmentMode:BUSY PP")
}
record(dfanout, "L4-OPCPA-NL2:PS5059:22:SetBothChannelsTrigDelay") {
    field(DESC, "NL2 set both channel delays")
    field(VAL, "790")
    field(OUTA, "L4-OPCPA-NL2:PS5059:22:Ch1TriggeringDelay PP")
    field(OUTB, "L4-OPCPA-NL2:PS5059:22:Ch2TriggeringDelay PP")
}
# The panel writes the waveform name here; the chain below applies it.
record(stringout, "CMD_NL2_LOAD_WAVEFORM") {
    field(DESC, "LOAD_WAVEFORM trigger")
    field(FLNK, "SIM:NL2:wfFan")
}
record(fanout, "SIM:NL2:wfFan") {
    field(DESC, "waveform apply order")
    field(LNK1, "SIM:NL2:wfSaveOld")
    field(LNK2, "SIM:NL2:wfApply")
}
record(stringout, "SIM:NL2:wfSaveOld") {
    field(DESC, "previous waveform -> latest")
    field(DOL, "SI_NL2_LOADED_WAVEFORM NPP NMS")
    field(OMSL, "closed_loop")
    field(OUT, "SI_NL2_LATEST_WAVEFORM PP")
}
record(stringout, "SIM:NL2:wfApply") {
    field(DESC, "command waveform -> loaded")
    field(DOL, "CMD_NL2_LOAD_WAVEFORM NPP NMS")
    field(OMSL, "closed_loop")
    field(OUT, "SI_NL2_LOADED_WAVEFORM PP")
}
