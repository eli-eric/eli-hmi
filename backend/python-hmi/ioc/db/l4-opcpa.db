# EPICS database for the L4 OPCPA panel — GENERATED, DO NOT EDIT.
#
#     python ioc/generate.py --zone test
#
# Source: config/zones/test.yaml
# Lasers: NL2
#
# Injected faults, so the panel's alarm paths are exercised from the
# first page load (see INJECTED_FAULTS in the generator):
#   * chiller 2 outlet temperature runs above HIHI  -> MAJOR
#   * chiller 3 water level is never processed      -> INVALID / UDF
#   * the last MSS permission is denied (ZSV MINOR) -> MINOR, reads NO
#   * one module reports error code 0021            -> ERR is not 0/n
#   * two flashlamp channels sit in STOP            -> tally is not all SB
#
# Renamed for this IOC. Each of these names a field of a synApps record type,
# which EPICS base does not have, so it is served as a plain `bi`
# record under a colon-separated name:
#   L4-OPCPA-NL2:PortControl.CNCT  ->  L4-OPCPA-NL2:PortControl:CNCT
#   L4-OPCPA-NL2:SetAlignmentMode.BUSY  ->  L4-OPCPA-NL2:SetAlignmentMode:BUSY
#
# Records scan at 1 second; analogue readouts random-walk inside their band.
#
# Lasers that watch the same site-wide PV (an MSS interlock, say) share
# one record — it is defined here once and read by all of them.

# --------------------------------------------------------------------------
# NL2 — status readbacks
# --------------------------------------------------------------------------
record(bi, "L4-OPCPA-NL2:PortControl:CNCT") {
    field(DESC, "NL2 controller connection")
    field(PINI, "YES")
    field(VAL, "1")
    field(ZNAM, "Disconnected")
    field(ONAM, "Connected")
}
record(bi, "L4-OPCPA-NL2:FullPower") {
    field(DESC, "NL2 at full power")
    field(PINI, "YES")
    field(VAL, "1")
    field(ZNAM, "off")
    field(ONAM, "on")
}
