    field(B, "0.125")
    field(C, "0.5")
    field(D, "3.0")
    field(CALC, "MIN(D,MAX(C,A+(RNDM-0.5)*B))")
    field(EGU, "mbar")
    field(PREC, "3")
    field(LOPR, "0.5")
    field(HOPR, "3.0")
    field(HIGH, "2.5")
    field(HSV, "MINOR")
    field(HIHI, "2.9")
    field(HHSV, "MAJOR")
}
