{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1,
      "description": "Zone-file schema version understood by the app (currently 1)."
    },
    "navigationItems": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "description": "Label shown in the top navigation."
          },
          "href": {
            "type": "string",
            "pattern": "^\\/(?:[a-z0-9-]+(?:\\/[a-z0-9-]+)*)?$",
            "description": "Route the item links to; must be in allowedRoutes."
          }
        },
        "required": [
          "text",
          "href"
        ],
        "additionalProperties": false
      },
      "description": "Items shown in the top navigation, in order."
    },
    "allowedRoutes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\/(?:[a-z0-9-]+(?:\\/[a-z0-9-]+)*)?$"
      },
      "description": "Routes reachable in this zone; first entry is the home route. Anything else redirects to /no-access."
    },
    "modules": {
      "description": "Per-module config file references.",
      "default": {},
      "type": "object",
      "properties": {
        "l4-opcpa": {
          "description": "L4 OPCPA laser config reference.",
          "type": "object",
          "properties": {
            "config": {
              "type": "string",
              "minLength": 1,
              "description": "Path to this module's config file, relative to the config dir root, e.g. modules/l4-opcpa/lasers.yaml."
            }
          },
          "required": [
            "config"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "navigationItems",
    "allowedRoutes"
  ],
  "additionalProperties": false
}
