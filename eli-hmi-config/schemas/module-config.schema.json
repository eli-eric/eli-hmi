{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1,
      "description": "Module-config schema version understood by the app (currently 1)."
    },
    "heading": {
      "type": "string",
      "minLength": 1,
      "description": "Heading text rendered in the top section."
    },
    "interlocks": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "description": "Non-empty text displayed in the UI."
        },
        "width": {
          "type": "string",
          "minLength": 1,
          "description": "CSS size used by the module-page layout."
        },
        "checkClearPv": {
          "description": "Optional PV used to clear the interlock group.",
          "type": "string",
          "minLength": 1
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "pvname": {
                "type": "string",
                "minLength": 1,
                "description": "Logical PV name passed to the frontend PV adapters."
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "description": "Non-empty text displayed in the UI."
              }
            },
            "required": [
              "pvname",
              "title"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "title",
        "items"
      ],
      "additionalProperties": false
    },
    "safetyPermission": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "description": "Non-empty text displayed in the UI."
        },
        "width": {
          "type": "string",
          "minLength": 1,
          "description": "CSS size used by the module-page layout."
        },
        "checkClearPv": {
          "description": "Optional PV used to clear the interlock group.",
          "type": "string",
          "minLength": 1
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "pvname": {
                "type": "string",
                "minLength": 1,
                "description": "Logical PV name passed to the frontend PV adapters."
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "description": "Non-empty text displayed in the UI."
              }
            },
            "required": [
              "pvname",
              "title"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "title",
        "items"
      ],
      "additionalProperties": false
    },
    "cleanDryAir": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "description": "Non-empty text displayed in the UI."
        },
        "width": {
          "type": "string",
          "minLength": 1,
          "description": "CSS size used by the module-page layout."
        },
        "volumes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "description": "Non-empty text displayed in the UI."
              },
              "width": {
                "type": "string",
                "minLength": 1,
                "description": "CSS size used by the module-page layout."
              },
              "pressure": {
                "type": "object",
                "properties": {
                  "pvName": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Logical PV name passed to the frontend PV adapters."
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Non-empty text displayed in the UI."
                  },
                  "options": {
                    "type": "object",
                    "properties": {
                      "format": {
                        "type": "string",
                        "enum": [
                          "exponential",
                          "precision",
                          "raw"
                        ],
                        "description": "Numeric display format."
                      },
                      "toExponential": {
                        "description": "Digits passed to Number.toExponential.",
                        "type": "number"
                      },
                      "toPrecision": {
                        "description": "Precision passed to Number.toPrecision.",
                        "type": "number"
                      }
                    },
                    "required": [
                      "format"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "pvName",
                  "label"
                ],
                "additionalProperties": false
              },
              "flow": {
                "type": "object",
                "properties": {
                  "pvName": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Logical PV name passed to the frontend PV adapters."
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Non-empty text displayed in the UI."
                  },
                  "options": {
                    "type": "object",
                    "properties": {
                      "format": {
                        "type": "string",
                        "enum": [
                          "exponential",
                          "precision",
                          "raw"
                        ],
                        "description": "Numeric display format."
                      },
                      "toExponential": {
                        "description": "Digits passed to Number.toExponential.",
                        "type": "number"
                      },
                      "toPrecision": {
                        "description": "Precision passed to Number.toPrecision.",
                        "type": "number"
                      }
                    },
                    "required": [
                      "format"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "pvName",
                  "label"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "title",
              "pressure",
              "flow"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "title",
        "volumes"
      ],
      "additionalProperties": false
