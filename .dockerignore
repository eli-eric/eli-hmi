# The Dockerfile copies only pyproject.toml, uv.lock, core/, components/,
# cameras/ and zones/. Everything else is kept out of the build context so it stays small
# and a local virtualenv or secret never reaches the daemon.
.git
.venv
.pytest_cache
**/__pycache__
**/*.pyc
snapshot
tests
tools
ioc
.agents
.claude
.vscode
.env*
